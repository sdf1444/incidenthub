{
  "name": "incidenthub",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run start:dev -w @incidenthub/api\" \"npm run dev -w @incidenthub/web\"",
    "build": "npm run build -w @incidenthub/api && npm run build -w @incidenthub/web",
    "test": "npm run test -w @incidenthub/api",
    "worker": "npm run worker -w @incidenthub/api",
    "test:process": "node scripts/process-smoke.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "pg": "^8.11.3"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
